# Illustration only. Source ignored files generated by setup-dev-db.sh and
# setup-demo-login.sh; never commit working passwords or JWT secrets.
# Required for app startup: DB_USERNAME, DB_PASSWORD, JWT_SECRET.
# DB_HOST/PORT/NAME and APP_PORT have development defaults.
# JWT_EXPIRATION_SECONDS defaults to 3600 (allowed 60..3600).
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=medical_maintenance_backend_dev
DB_USERNAME=your_local_postgresql_role
DB_PASSWORD=replace_with_a_private_local_password
SPRING_PROFILES_ACTIVE=dev
APP_PORT=8080
JWT_SECRET=replace_with_base64_encoded_32_or_more_random_bytes
JWT_EXPIRATION_SECONDS=3600

# Exact development browser origin for CORS (no wildcard).
FRONTEND_ORIGIN=http://localhost:5173
