+          <div><dt>Khoa/Phòng</dt><dd>{account.departmentName || 'Không có khoa/phòng'}</dd></div><div><dt>Trạng thái</dt><dd>{account.active ? 'Hoạt động' : 'Không hoạt động'}</dd></div></dl>
